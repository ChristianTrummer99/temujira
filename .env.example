# All variables are optional. Docker Compose reads a root .env file for the settings
# in its section below. A bare Node process does not load .env automatically; export
# those variables through your shell or service manager.

# Docker Compose host binding. Loopback is the safe default for a host reverse proxy.
TEMUJIRA_BIND=127.0.0.1
TEMUJIRA_PORT=3000

# Max attachment size in MB. Docker Compose passes this into the container.
MAX_UPLOAD_MB=50

# Cookie Secure flag. Unset/auto = on when the request arrives over https,
# honoring X-Forwarded-Proto from a reverse proxy. Set 1/0 to force.
# COOKIE_SECURE=1

# Optional headless first-admin provisioning. These values only apply while there are
# no users. Remove all three lines and recreate the container after setup.
# TEMUJIRA_ADMIN_EMAIL=admin@example.com
# TEMUJIRA_ADMIN_PASSWORD='change-me-please'
# TEMUJIRA_ADMIN_NAME=Admin

# The settings below are for a bare Node deployment. The Docker image supplies its own
# DATA_DIR, PORT, NODE_ENV, and WEB_DIST values.

# Listen address and port.
HOST=127.0.0.1
PORT=3000

# Where the SQLite DB and uploads live (one directory = one backup target).
DATA_DIR=./data

# Exported web app. Required when the same server should host the UI.
WEB_DIST=./apps/web/dist

# Set this exactly in production so development-only CORS is disabled.
NODE_ENV=production

# Web build-time API origin. Leave unset/empty for the supported same-origin deployment.
# EXPO_PUBLIC_API_URL=
