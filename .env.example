# All variables are OPTIONAL — temujira boots with sensible defaults and no secrets.

# Where the SQLite DB and uploads live (one directory = one backup target).
DATA_DIR=./data

# HTTP port.
PORT=3000

# Max attachment size in MB.
MAX_UPLOAD_MB=50

# Cookie Secure flag. Unset = auto (on when the request arrives over https,
# honoring X-Forwarded-Proto from a reverse proxy). Set 1/0 to force.
# COOKIE_SECURE=1

# Headless first-admin provisioning: applied at boot only while no users exist.
# TEMUJIRA_ADMIN_EMAIL=admin@example.com
# TEMUJIRA_ADMIN_PASSWORD=change-me-please
# TEMUJIRA_ADMIN_NAME=Admin
